import rolando.*
describe "Mochila de Rolando" {
    test "Rolando guarda objetos en la mochila, y comprueba tener la espada del destino y el libro de hechizos" {
        rolando.recolectar(espadaDelDestino)
        rolando.recolectar(libroDeHechizos)
        assert.throwsException({rolando.recolectar(collarDivino)})
        assert.that(rolando.tieneEnMochila(espadaDelDestino))
        assert.that(rolando.tieneEnMochila(libroDeHechizos))
        
    }
}

describe "Rolando llega al castillo" {
  test "Rolando recolecta, deja objetos en el castillo y vuelve a recolectar" {
        rolando.recolectar(espadaDelDestino)
        rolando.recolectar(libroDeHechizos)
        rolando.llegaAlCastillo()
        rolando.recolectar(collarDivino)
        rolando.llegaAlCastillo()
        assert.that(castillo.tieneEnAlmacen(libroDeHechizos))
        assert.that(castillo.tieneEnAlmacen(espadaDelDestino))
        assert.that(castillo.tieneEnAlmacen(collarDivino))
  }
}

describe "Rolando y sus pertenencias" {
  test "Rolando tiene 3 objetos en total, solo 1 está en su mochila" {
        rolando.recolectar(espadaDelDestino)
        rolando.recolectar(collarDivino)
        rolando.llegaAlCastillo()
        rolando.recolectar(armaduraDeAceroValyrio)
        assert.equals(3, rolando.posesiones().size())
  }
}

describe "Historia de los encuentos de artefactos" {
  test "Rolando encuentra y recolecta ciertos artefactos, despues vé todo lo que encontro" {
        rolando.encontrarYRecolectarObjeto(espadaDelDestino)
        rolando.encontrarYRecolectarObjeto(libroDeHechizos)
        rolando.encontrar(collarDivino)
        rolando.llegaAlCastillo()
        rolando.encontrarYRecolectarObjeto(armaduraDeAceroValyrio)
        rolando.encontrarYRecolectarObjeto(collarDivino)
        assert.equals(espadaDelDestino, rolando.objetosEncontrados().get(0))
        assert.equals(libroDeHechizos, rolando.objetosEncontrados().get(1))
        assert.equals(collarDivino, rolando.objetosEncontrados().get(2))
        assert.equals(armaduraDeAceroValyrio, rolando.objetosEncontrados().get(3))
        assert.equals(collarDivino, rolando.objetosEncontrados().get(4))
  }
}

describe "Ejemplo Batalla de rolando" {
  test "Rolando pelea y comprueba" {
        rolando.asignarPoderBase(5)
        rolando.recolectar(espadaDelDestino)
        rolando.recolectar(collarDivino)
        rolando.recolectar(armaduraDeAceroValyrio)
        assert.equals(19, rolando.poderDePelea())
        rolando.pelearBatalla()
        assert.equals(6, rolando.poderBase())
        assert.equals(18, rolando.poderDePelea())
        rolando.pelearBatalla()
        assert.equals(7, rolando.poderBase())
        assert.equals(21.5, rolando.poderDePelea())
        rolando.pelearBatalla()
        assert.equals(8, rolando.poderBase())
        assert.equals(24, rolando.poderDePelea())
  }
}

describe "Ejemplo Libro de Hechizos" {
    test "Evolucion del aporte del libro de hechizos en cada batalla" {
      rolando.asignarPoderBase(5)
      castillo.almacenarArtefacto(espadaDelDestino)
      castillo.almacenarArtefacto(armaduraDeAceroValyrio)
      castillo.almacenarArtefacto(collarDivino)
      rolando.recolectar(libroDeHechizos)
      assert.equals(4, libroDeHechizos.poderQueAporta(rolando))
      assert.equals(9, rolando.poderDePelea())
      rolando.pelearBatalla() 
      assert.equals(6, libroDeHechizos.poderQueAporta(rolando))
      assert.equals(12, rolando.poderDePelea())
      rolando.pelearBatalla()
      assert.equals(7, libroDeHechizos.poderQueAporta(rolando))
      assert.equals(14, rolando.poderDePelea())
      rolando.pelearBatalla() 
      assert.equals(0, libroDeHechizos.poderQueAporta(rolando))
      assert.equals(8, rolando.poderDePelea())
    }
}